---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;
const target = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/en/projects/${slug}/`;
---
<!doctype html><html lang="en"><head><meta http-equiv="refresh" content={`0; url=${target}`} /></head><body><a href={target}>Continue to Zinc Lab</a></body></html>
