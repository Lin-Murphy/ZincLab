---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import HomeFilms from '@/components/HomeFilms.astro';
import ProjectsGrid from '@/components/ProjectsGrid.astro';
import TalentList from '@/components/TalentList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactFooter from '@/components/ContactFooter.astro';
import { locales, type Locale, ui } from '@/lib/i18n';
export const getStaticPaths = (async () => locales.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;
const locale = Astro.params.locale as Locale;
const films = (await getCollection('home-films')).sort((a, b) => a.data.order - b.data.order);
const talents = (await getCollection('talents')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout locale={locale} active="home" navTheme="dark" bodyClass="scene-page" canonicalPath={Astro.url.pathname}>
  <main id="main" class="scene-viewport" data-scene-experience data-locale={locale} data-base={import.meta.env.BASE_URL}>
    <div class="scene-track" data-scene-track>
      <section class="scene scene-home" data-scene="home" data-nav-theme="dark" aria-label={ui[locale].nav.home}><HomeFilms films={films} locale={locale} /></section>
      <section class="scene scene-talents" data-scene="talents" data-nav-theme="light" aria-label={ui[locale].nav.talents}><div class="scene-label">{ui[locale].roster}</div><TalentList talents={talents} locale={locale} /></section>
      <section class="scene scene-projects" data-scene="projects" data-nav-theme="light" aria-label={ui[locale].nav.projects}><div class="scene-heading"><span>{ui[locale].archive}</span><h2>{ui[locale].nav.projects}</h2></div><ProjectsGrid projects={projects} locale={locale} /><ContactFooter locale={locale} /></section>
    </div>
    <div class="scene-meter" aria-hidden="true"><span data-scene-meter></span></div>
  </main>
  <script src="../../scripts/scene-controller.ts"></script>
</BaseLayout>
