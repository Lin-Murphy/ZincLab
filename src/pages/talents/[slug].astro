---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = (async () => {
  const talents = await getCollection('talents');
  return talents.map((talent) => ({ params: { slug: talent.data.slug }, props: { talent } }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;
const target = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/en/talents/${slug}/`;
---
<!doctype html><html lang="en"><head><meta http-equiv="refresh" content={`0; url=${target}`} /></head><body><a href={target}>Continue to Zinc Lab</a></body></html>
